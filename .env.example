# GigaChat API: ключ авторизации (из console.sber.ai)
GIGACHAT_AUTH_KEY=

# GigaChat: модель (default: GigaChat-2-Max)
GIGACHAT_MODEL=GigaChat-2-Max

# GigaChat: scope для корпоративного API (default: GIGACHAT_API_CORP)
# GIGACHAT_SCOPE=GIGACHAT_API_CORP

# GigaChat: температура генерации (0-2, default: 0.11)
# GIGACHAT_TEMPERATURE=0.11

# GigaChat: timeout в миллисекундах (default: 1000)
# GIGACHAT_TIMEOUT=1000

# Отражение-петля: максимальное количество итераций Coder <-> Reviewer (default: 3)
# MAX_REFLECTION_ITERATIONS=3

# RAG: DSN PostgreSQL (asyncpg). Пусто => retrieve работает в fallback (пустой context)
# В docker-compose хост=postgres, пароль берётся из POSTGRES_PASSWORD (ниже).
# ВНИМАНИЕ: для прода СМЕНИТЕ пароль на сильный — не оставляйте дефолтный 'postgres'.
DATABASE_URL=postgresql://postgres:CHANGE_ME@postgres:5432/agent_forge

# Пароль postgres для docker-compose (${POSTGRES_PASSWORD}). Задайте сильный для прода.
POSTGRES_PASSWORD=CHANGE_ME

# GigaChat Embeddings: модель (default: EmbeddingsGigaR)
# GIGACHAT_EMBEDDINGS_MODEL=EmbeddingsGigaR

# RAG: размер выдачи и константа RRF (default: 5, 60)
# RAG_TOP_K=5
# RAG_RRF_K=60

# Langfuse observability. Пустые ключи => трейсинг выключен (no-op), граф не падает.
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
# LANGFUSE_HOST=https://cloud.langfuse.com
# LANGFUSE_ENABLED=true
