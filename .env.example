# GigaChat API: ключ авторизации (из console.sber.ai)
GIGACHAT_AUTH_KEY=

# GigaChat: модель (default: GigaChat-2-Max)
GIGACHAT_MODEL=GigaChat-2-Max

# GigaChat: scope для корпоративного API (default: GIGACHAT_API_CORP)
# GIGACHAT_SCOPE=GIGACHAT_API_CORP

# GigaChat: температура генерации (0-2, default: 0.11)
# GIGACHAT_TEMPERATURE=0.11

# GigaChat: timeout в миллисекундах (default: 1000)
# GIGACHAT_TIMEOUT=1000

# Отражение-петля: максимальное количество итераций Coder <-> Reviewer (default: 3)
# MAX_REFLECTION_ITERATIONS=3
